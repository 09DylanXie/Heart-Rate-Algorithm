# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Pytest / Testing
.pytest_cache/
.coverage
htmlcov/

# IDE & OS specific files (crucial for multi-collaborator repos!)
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch / temporary output plots or large binary dumps (keep sample CSVs, ignore temp outputs)
outputs/
*.log
*.tmp

